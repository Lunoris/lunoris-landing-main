# ============================================================================
# LUNORIS NEWS PUBLISHING API — SERVER-ONLY SECURITY SECRETS
# Never expose these with NEXT_PUBLIC_ prefix.
# ============================================================================

# 1. Bearer API Key (used in Authorization: Bearer <key> or X-Api-Key header)
LUNORIS_NEWS_API_KEY="replace_with_64_char_random_hex_key"

# 2. HMAC-SHA256 Signing Secret (used to verify X-Lunoris-Timestamp + X-Lunoris-Signature)
LUNORIS_NEWS_HMAC_SECRET="replace_with_64_char_random_hmac_secret"

# 3. Optional comma-separated IP allowlist for write endpoints (leave empty to allow any IP with valid key/signature)
LUNORIS_ALLOWED_IPS=""
